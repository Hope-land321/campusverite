# Configuration de Production CampusVerite

# Clé secrète Flask pour signer les sessions
SECRET_KEY=remplacez-moi-par-une-cle-securisee-de-32-caracteres

# Chemin absolu ou relatif vers la base de données SQLite
CAMPUSVERITE_DB_PATH=data/campusverite.db

# Seuil de votes pour transformer un avis en pétition
PETITION_THRESHOLD=10

# Seuil de signalements pour masquer automatiquement un avis
REPORT_HIDE_THRESHOLD=5

# Mot de passe administrateur pour le backoffice (par défaut : admin123)
ADMIN_PASSWORD=admin123

